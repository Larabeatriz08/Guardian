{
  "manifest_version": 3,
  "name": "Guardian",
  "version": "0.3.0",
  "description": "Controle parental transparente: registra e bloqueia sites inapropriados neste computador.",
  "permissions": ["tabs", "alarms", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    }
  ]
}